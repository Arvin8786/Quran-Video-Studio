# APP_URL: Public HTTPS origin of this publishing service (e.g. https://your-studio.onrender.com).
# Used to build the OAuth callback (APP_URL/auth/callback). Detected automatically on Render.
APP_URL=""

# Social Media OAuth Credentials (Optional: used for automatic 1-click OAuth popups)
# You can also connect channels directly via OAuth Access Tokens in the UI!
# YouTube / Google Data API OAuth:
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Meta / Facebook Page Graph API:
META_APP_ID=""
META_APP_SECRET=""

# TikTok Video Kit & Open API:
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# Optional: Meta API version (must remain supported by Meta).
META_GRAPH_VERSION="v24.0"

# Optional: private persistent storage directory (defaults to .data).
# PROEASE_DATA_DIR="/path/to/private/studio-data"

# Publishing service access (never put this in VITE_* or GitHub Pages assets).
STUDIO_ACCESS_KEY=""
STUDIO_ALLOWED_ORIGINS="https://arvin8786.github.io"
# Optional frontend service origin; public setting, not a credential.
VITE_API_BASE_URL=""
# GitHub Pages builds set these automatically.
# VITE_STATIC="true"
# VITE_BASE_PATH="/Quran-Video-Studio/"
